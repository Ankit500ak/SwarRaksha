# SwarRaksha environment — copy to .env and adjust. NEVER commit .env.
# Local dev defaults work out of the box with `make dev`.

# Database (local default: SQLite file inside apps/api/)
DATABASE_URL=sqlite:///./swarraksha.db
# Production example:
# DATABASE_URL=postgresql+psycopg://swarraksha:<password>@db:5432/swarraksha

# Auth
JWT_SECRET=dev-only-secret-change-in-production

# Dev mode: 1 = OTPs printed to the API server log (local only).
# Production MUST use 0 and a real email delivery provider.
SWAR_DEV_MODE=1

# Voiceprint cosine threshold (MFCC baseline starting value, uncalibrated)
VOICEPRINT_THRESHOLD=0.80

# Web build: API base URL baked in at build time
VITE_API_URL=http://localhost:8000

# Docker compose only
POSTGRES_PASSWORD=swarraksha-dev
