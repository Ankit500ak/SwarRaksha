# SwarRaksha environment — copy to .env and adjust. NEVER commit .env.
# Local dev defaults work out of the box with `make dev`.

# Environment posture: dev | production.
# production = fail-closed: the API refuses to boot unless JWT_SECRET,
# VOICEPRINT_ENC_KEY, SMTP and CORS below are all safely configured.
SWAR_ENV=dev

# Database (local default: SQLite file inside apps/api/)
DATABASE_URL=sqlite:///./swarraksha.db
# Production example:
# DATABASE_URL=postgresql+psycopg://swarraksha:<password>@db:5432/swarraksha
# Explicit opt-in to SQLite in production (not recommended):
SWAR_ALLOW_SQLITE=0

# Auth — in production: >= 32 chars, never the dev default below.
JWT_SECRET=dev-only-secret-change-in-production

# Dev mode: 1 = OTPs printed to the API server log (local only).
# Production MUST use 0 (boot is refused otherwise).
SWAR_DEV_MODE=1

# SMTP for OTP email delivery (required in production).
# SMTP_PORT 465 = implicit TLS; 587 = STARTTLS (SMTP_USE_TLS=1).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Voiceprint encryption at rest: base64-encoded 32-byte key.
# Generate: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Required in production; in dev a key is derived from JWT_SECRET if unset.
VOICEPRINT_ENC_KEY=

# OTP abuse limits
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_EMAIL=3
OTP_MAX_REQUESTS_PER_IP=10
OTP_REQUEST_WINDOW_MIN=15

# CORS allowlist (comma-separated). No wildcard allowed in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits (requests per minute, per IP, in-memory)
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CLIP_PER_MIN=30

# Uploads
MAX_UPLOAD_BYTES=10485760
MAX_CLIP_SECONDS=120
MAX_REQUEST_BYTES=32505856

# Voiceprint cosine threshold (MFCC baseline starting value, uncalibrated)
VOICEPRINT_THRESHOLD=0.80

# Web build: API base URL baked in at build time
VITE_API_URL=http://localhost:8000

# Docker compose only
POSTGRES_PASSWORD=swarraksha-dev
